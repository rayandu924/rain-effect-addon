{
  "runtime": "canvas-v1",
  "name": "Rain Effect",
  "description": "Beautiful rain effect with realistic droplets and customizable settings.",
  "version": "3.2.4",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "none"
  },
  "settings": [
    { "id": "rain", "type": "section", "label": "Rain" },
    { "id": "rainColor", "type": "color", "label": "Rain color", "description": "Color of the raindrops", "parent": "rain", "scope": "layer", "default": "#a8c8e8" },
    { "id": "rainIntensity", "type": "range", "label": "Rain intensity", "description": "Number of raindrops", "parent": "rain", "scope": "layer", "min": 100, "max": 50000, "step": 100, "default": 200 },
    { "id": "rainSpeed", "type": "range", "label": "Fall speed", "description": "How fast the rain falls", "parent": "rain", "scope": "layer", "min": 0.5, "max": 3, "step": 0.1, "default": 1.7 },
    { "id": "dropLength", "type": "range", "label": "Drop length", "description": "Length of rain streaks", "parent": "rain", "scope": "layer", "min": 5, "max": 50, "step": 1, "default": 42 },
    { "id": "dropWidth", "type": "range", "label": "Drop width", "description": "Thickness of raindrops", "parent": "rain", "scope": "layer", "min": 0.5, "max": 4, "step": 0.1, "default": 0.8 },
    { "id": "wind", "type": "section", "label": "Wind" },
    { "id": "windAngle", "type": "range", "label": "Wind angle", "description": "Angle of rain", "parent": "wind", "scope": "layer", "min": -45, "max": 45, "step": 1, "default": -5 },
    { "id": "windVariation", "type": "range", "label": "Wind variation", "description": "Random variation in wind", "parent": "wind", "scope": "layer", "min": 0, "max": 20, "step": 1, "default": 0 },
    { "id": "effects", "type": "section", "label": "Effects" },
    { "id": "opacity", "type": "range", "label": "Opacity", "description": "Transparency of raindrops", "parent": "effects", "scope": "layer", "min": 0.1, "max": 1, "step": 0.05, "default": 0.6 },
    { "id": "enableGlow", "type": "boolean", "label": "Enable glow", "description": "Add a soft glow effect", "parent": "effects", "scope": "layer", "default": true },
    { "id": "glowIntensity", "type": "range", "label": "Glow intensity", "description": "Brightness of the glow effect", "parent": "effects", "scope": "layer", "min": 0.1, "max": 1, "step": 0.05, "default": 0.3 }
  ]
}
